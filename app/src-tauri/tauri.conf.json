{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATME",
  "version": "0.1.1",
  "identifier": "dev.atme.engine",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ATME — Autonomous Technical Media Engine",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/atme-sidecar"],
    "resources": {"../../sidecar-dist/atme-sidecar/_internal/": "_internal/"}
  }
}
