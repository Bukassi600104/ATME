{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atme.local/schemas/v1/cue-timeline.schema.json",
  "title": "CueTimeline",
  "description": "Alignment output consumed by the renderer: word timings on the FINAL audio plus directive triggers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "duration_ms", "audio", "words", "directives"],
  "properties": {
    "contract_version": { "const": "1" },
    "duration_ms": { "type": "integer", "minimum": 1 },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "lufs"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sample_rate": { "type": "integer" },
        "lufs": { "type": "number", "minimum": -30, "maximum": -6 }
      }
    },
    "words": { "type": "array", "items": { "$ref": "#/$defs/word" } },
    "directives": { "type": "array", "items": { "$ref": "#/$defs/directive" } },
    "edl_original_to_final_ms": { "type": "array", "items": { "$ref": "#/$defs/edlSpan" } }
  },
  "$defs": {
    "word": {
      "type": "object", "additionalProperties": false,
      "required": ["word", "start_ms", "end_ms", "scene_id"],
      "properties": {
        "word": { "type": "string" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "scene_id": { "type": "integer", "minimum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "flagged": { "type": "boolean" }
      }
    },
    "directive": {
      "type": "object", "additionalProperties": false,
      "required": ["at_ms", "scene_id", "action", "target_id"],
      "properties": {
        "at_ms": { "type": "integer", "minimum": 0 },
        "scene_id": { "type": "integer", "minimum": 1 },
        "action": { "enum": ["draw", "reveal", "highlight", "camera"] },
        "target_id": { "type": "string" }
      }
    },
    "edlSpan": {
      "type": "object", "additionalProperties": false,
      "required": ["orig_start_ms", "orig_end_ms", "final_start_ms"],
      "properties": {
        "orig_start_ms": { "type": "integer", "minimum": 0 },
        "orig_end_ms": { "type": "integer", "minimum": 0 },
        "final_start_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
