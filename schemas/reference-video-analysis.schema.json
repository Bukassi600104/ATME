{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atme.local/schemas/v1/reference-video-analysis.schema.json",
  "title": "ReferenceVideoAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "analysis_id", "video", "evidence", "narrative_beats", "visual_events", "metrics", "observations", "interpretations"],
  "properties": {
    "contract_version": {"const": "1"},
    "analysis_id": {"type": "string", "pattern": "^ref-[a-z0-9-]+$"},
    "video": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "title", "duration_ms", "accessed_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "integer", "minimum": 1},
        "published_at": {"type": "string"},
        "accessed_at": {"type": "string", "format": "date-time"},
        "format": {"enum": ["digital_whiteboard", "physical_lightboard", "presenter", "tutorial", "editorial", "mixed"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["transcript_source", "visual_method"],
      "properties": {
        "transcript_source": {"enum": ["creator_captions", "automatic_captions", "authorized_local_transcription", "manual", "unavailable"]},
        "visual_method": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "narrative_beats": {"type": "array", "items": {"$ref": "#/$defs/beat"}},
    "visual_events": {"type": "array", "items": {"$ref": "#/$defs/visualEvent"}},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "spoken_word_count": {"type": "integer", "minimum": 0},
        "words_per_minute": {"type": "number", "minimum": 0},
        "median_minor_change_ms": {"type": "integer", "minimum": 0},
        "median_major_reveal_ms": {"type": "integer", "minimum": 0},
        "camera_event_count": {"type": "integer", "minimum": 0},
        "visual_event_count": {"type": "integer", "minimum": 0},
        "persistent_object_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "interpretations": {"type": "array", "items": {"$ref": "#/$defs/interpretation"}}
  },
  "$defs": {
    "beat": {
      "type": "object", "additionalProperties": false,
      "required": ["beat_id", "kind", "start_ms", "end_ms", "summary"],
      "properties": {
        "beat_id": {"type": "string"},
        "kind": {"enum": ["hook", "stakes", "context", "mechanism", "evidence", "complication", "pivot", "resolution", "sponsor", "other"]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "visualEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "at_ms", "action", "description", "major"],
      "properties": {
        "event_id": {"type": "string"},
        "at_ms": {"type": "integer", "minimum": 0},
        "action": {"enum": ["reveal", "draw", "connect", "move", "replace", "count", "cross_out", "group", "split", "highlight", "remove", "camera_hold", "camera_pan", "camera_zoom", "camera_reframe", "cut", "other"]},
        "description": {"type": "string", "minLength": 1},
        "trigger_phrase": {"type": "string", "maxLength": 120},
        "major": {"type": "boolean"},
        "persistent": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "statement", "evidence_ms"],
      "properties": {
        "observation_id": {"type": "string"},
        "statement": {"type": "string", "minLength": 1},
        "evidence_ms": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "interpretation": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "observation_ids", "confidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    }
  }
}
