{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atme.local/schemas/v1/visual-plan.schema.json",
  "title": "VisualPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "topic", "beats"],
  "properties": {
    "contract_version": {"const": "1"},
    "topic": {"type": "string"},
    "beats": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/beat"}}
  },
  "$defs": {
    "beat": {
      "type": "object", "additionalProperties": false,
      "required": ["beat_id", "scene_id", "narration", "trigger_phrase", "purpose", "assets", "actions", "layout", "camera", "continuity", "emphasis", "fallback"],
      "properties": {
        "beat_id": {"type": "string", "pattern": "^beat-[0-9]{3}$"},
        "scene_id": {"type": "integer", "minimum": 1},
        "narration": {"type": "string", "minLength": 1},
        "trigger_phrase": {"type": "string", "minLength": 1},
        "purpose": {"enum": ["identity", "quantity", "change", "causality", "comparison", "sequence", "containment", "conflict", "location", "emphasis"]},
        "assets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "actions": {"type": "array", "minItems": 1, "items": {"enum": ["reveal", "draw", "connect", "move", "replace", "count", "cross_out", "group", "split", "highlight", "remove"]}},
        "layout": {"type": "string", "minLength": 1},
        "camera": {"type": "object", "additionalProperties": false, "required": ["action", "subject"], "properties": {"action": {"enum": ["hold", "reframe", "pan", "zoom", "follow", "return"]}, "subject": {"type": "string"}}},
        "continuity": {"type": "object", "additionalProperties": false, "required": ["keep", "remove"], "properties": {"keep": {"type": "array", "items": {"type": "string"}}, "remove": {"type": "array", "items": {"type": "string"}}}},
        "emphasis": {"type": "string"},
        "fallback": {"type": "string", "minLength": 1}
      }
    }
  }
}
